pipeline {
  agent any

  environment {
   
    GIT_REPO_URL       = "https://github.com/indukuriv/task2.git"
    AWS_REGION         = "us-east-1"
    ECR_ACCOUNT_ID     = "521051890477"
    FRONTEND_ECR_REPO  = "${ECR_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/frontend"
    BACKEND_ECR_REPO   = "${ECR_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/backend"
    ECS_CLUSTER        = "lightfeather-cluster"
    FRONTEND_SERVICE   = "frontend-service"
    BACKEND_SERVICE    = "backend-service"
    IMAGE_TAG          = "${BUILD_NUMBER}"
  }

  stages {
    stage('Install Prerequisites') {
      steps {
        sh '''
          set -e
          # Detect OS
          if [ -r /etc/os-release ]; then
            . /etc/os-release
          else
            echo "Cannot detect OS" >&2; exit 1
          fi

          case "$ID" in
            amzn|amazon)
              echo "Amazon Linux detected"
              amazon-linux-extras install docker -y
              yum install -y git unzip awscli
              ;;
            ubuntu|debian)
              echo "Ubuntu/Debian detected"
              sudo apt-get update
              sudo apt-get install -y docker.io git unzip awscli
              ;;
            centos|rhel)
              echo "RHEL/CentOS detected"
              sudo yum install -y docker git unzip awscli
              ;;
            *)
              echo "Unsupported OS: $ID" >&2; exit 1
              ;;
          esac

          # Install Terraform if missing
          if ! command -v terraform &> /dev/null; then
            TERRAFORM_VERSION="1.4.6"
            wget -q https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip
            unzip -q terraform_${TERRAFORM_VERSION}_linux_amd64.zip
            sudo mv terraform /usr/local/bin/
          fi

          # Install Node.js 16 if missing
          if ! command -v node &> /dev/null; then
            curl -sL https://rpm.nodesource.com/setup_16.x | sudo bash -
            sudo apt-get install -y nodejs || sudo yum install -y nodejs
          fi

          # Verify installations
          docker --version
          git --version
          aws --version
          terraform -v
          node --version
          npm --version
        '''
      }
    }

    stage('Clone Repo') {
      steps {
        git branch: 'main', url: "${GIT_REPO_URL}"
      }
    }

    stage('Build Docker Images') {
      parallel {
        stage('Build Frontend') {
          steps {
            dir('frontend') {
              sh 'docker build -t ${FRONTEND_ECR_REPO}:${IMAGE_TAG} .'
            }
          }
        }
        stage('Build Backend') {
          steps {
            dir('backend') {
              sh 'docker build -t ${BACKEND_ECR_REPO}:${IMAGE_TAG} .'
            }
          }
        }
      }
    }

    stage('Login to ECR') {
      steps {
        sh '''
          aws ecr get-login-password --region ${AWS_REGION} \
            | docker login --username AWS --password-stdin ${FRONTEND_ECR_REPO}
          aws ecr get-login-password --region ${AWS_REGION} \
            | docker login --username AWS --password-stdin ${BACKEND_ECR_REPO}
        '''
      }
    }

    stage('Push Images to ECR') {
      parallel {
        stage('Push Frontend') {
          steps {
            sh 'docker push ${FRONTEND_ECR_REPO}:${IMAGE_TAG}'
          }
        }
        stage('Push Backend') {
          steps {
            sh 'docker push ${BACKEND_ECR_REPO}:${IMAGE_TAG}'
          }
        }
      }
    }

    stage('Deploy to ECS') {
      steps {
        sh '''
          aws ecs update-service \
            --cluster ${ECS_CLUSTER} \
            --service ${FRONTEND_SERVICE} \
            --force-new-deployment \
            --region ${AWS_REGION}

          aws ecs update-service \
            --cluster ${ECS_CLUSTER} \
            --service ${BACKEND_SERVICE} \
            --force-new-deployment \
            --region ${AWS_REGION}
        '''
      }
    }
  }

  post {
    success {
      echo '✅ Full-stack deployment succeeded!'
    }
    failure {
      echo '❌ Full-stack deployment failed – check the logs.'
    }
  }
}
