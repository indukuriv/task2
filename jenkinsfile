pipeline {
  agent any

  environment {
    // Hard-coded values
    GIT_REPO_URL       = "https://github.com/indukuriv/task1.git"
    AWS_REGION         = "us-east-1"
    ECR_ACCOUNT_ID     = "521051890477"
    FRONTEND_ECR_REPO  = "521051890477.dkr.ecr.us-east-1.amazonaws.com/frontend"
    BACKEND_ECR_REPO   = "521051890477.dkr.ecr.us-east-1.amazonaws.com/backend"
    ECS_CLUSTER        = "lightfeather-cluster"
    FRONTEND_SERVICE   = "frontend-service"
    BACKEND_SERVICE    = "backend-service"
    // Jenkins BUILD_NUMBER will be the image tag
    IMAGE_TAG          = "${BUILD_NUMBER}"
  }

  stages {
    stage('Install Prerequisites') {
      steps {
        sh '''
          set -e

          # 1) Docker
          if ! command -v docker &> /dev/null; then
            amazon-linux-extras install docker -y
            systemctl enable docker
            systemctl start docker
            usermod -aG docker jenkins
          fi

          # 2) Git & unzip
          if ! command -v git &> /dev/null; then
            yum install -y git unzip
          fi

          # 3) AWS CLI v2
          if ! command -v aws &> /dev/null; then
            curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
            unzip -q awscliv2.zip && ./aws/install
          fi

          # 4) Terraform
          if ! command -v terraform &> /dev/null; then
            TERRAFORM_VERSION="1.4.6"
            wget -q https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip
            unzip -q terraform_${TERRAFORM_VERSION}_linux_amd64.zip
            mv terraform /usr/local/bin/
          fi

          # 5) Node.js 16
          if ! command -v node &> /dev/null; then
            curl -sL https://rpm.nodesource.com/setup_16.x | bash -
            yum install -y nodejs
          fi

          # 6) Verify installs
          docker --version
          git --version
          aws --version
          terraform -v
          node --version
          npm --version
        '''
      }
    }

    stage('Clone Repo') {
      steps {
        git branch: 'main', url: "${GIT_REPO_URL}"
      }
    }

    stage('Build Docker Images') {
      parallel {
        stage('Build Frontend') {
          steps {
            dir('frontend') {
              sh '''
                docker build -t ${FRONTEND_ECR_REPO}:${IMAGE_TAG} .
              '''
            }
          }
        }
        stage('Build Backend') {
          steps {
            dir('backend') {
              sh '''
                docker build -t ${BACKEND_ECR_REPO}:${IMAGE_TAG} .
              '''
            }
          }
        }
      }
    }

    stage('Login to ECR') {
      steps {
        sh '''
          aws ecr get-login-password --region ${AWS_REGION} \
            | docker login --username AWS --password-stdin ${FRONTEND_ECR_REPO}
          aws ecr get-login-password --region ${AWS_REGION} \
            | docker login --username AWS --password-stdin ${BACKEND_ECR_REPO}
        '''
      }
    }

    stage('Push Images to ECR') {
      parallel {
        stage('Push Frontend') {
          steps {
            sh '''
              docker push ${FRONTEND_ECR_REPO}:${IMAGE_TAG}
            '''
          }
        }
        stage('Push Backend') {
          steps {
            sh '''
              docker push ${BACKEND_ECR_REPO}:${IMAGE_TAG}
            '''
          }
        }
      }
    }

    stage('Deploy to ECS') {
      steps {
        sh '''
          aws ecs update-service \
            --cluster ${ECS_CLUSTER} \
            --service ${FRONTEND_SERVICE} \
            --force-new-deployment \
            --region ${AWS_REGION}

          aws ecs update-service \
            --cluster ${ECS_CLUSTER} \
            --service ${BACKEND_SERVICE} \
            --force-new-deployment \
            --region ${AWS_REGION}
        '''
      }
    }
  }

  post {
    success {
      echo '✅ Full-stack deployment succeeded!'
    }
    failure {
      echo '❌ Full-stack deployment failed – check the logs.'
    }
  }
}
