pipeline {
  agent any

  environment {
    AWS_REGION        = 'us-east-1'
    AWS_DEFAULT_REGION= "${AWS_REGION}"
    // Grab your AWS Account ID dynamically
    AWS_ACCOUNT_ID    = sh(script: "aws sts get-caller-identity --query Account --output text", returnStdout: true).trim()
    BACKEND_ECR       = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/lf-backend"
    FRONTEND_ECR      = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/lf-frontend"
    IMAGE_TAG         = "${env.BUILD_NUMBER}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Docker Build & Smoke Test') {
      steps {
        // Build images with local “test” tags
        dir('backend') {
          sh "docker build -t backend-test:${IMAGE_TAG} ."
        }
        dir('frontend') {
          sh "docker build -t frontend-test:${IMAGE_TAG} ."
        }

        // Run & test them
        script {
          // Backend smoke-test
          sh "docker run -d --rm --name be-test -p 8080:8080 backend-test:${IMAGE_TAG}"
          sleep 10
          sh "curl -f http://localhost:8080 || { echo 'Backend did not respond'; exit 1; }"
          sh "docker stop be-test"

          // Frontend smoke-test
          sh "docker run -d --rm --name fe-test -p 3000:3000 frontend-test:${IMAGE_TAG}"
          sleep 10
          sh "curl -f http://localhost:3000 || { echo 'Frontend did not respond'; exit 1; }"
          sh "docker stop fe-test"
        }
      }
    }

    stage('Build & Push Backend') {
      steps {
        dir('backend') {
          sh """
            docker tag backend-test:${IMAGE_TAG} ${BACKEND_ECR}:${IMAGE_TAG}
            aws ecr get-login-password \
              | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
            docker push ${BACKEND_ECR}:${IMAGE_TAG}
          """
        }
      }
    }

    stage('Build & Push Frontend') {
      steps {
        dir('frontend') {
          sh """
            docker tag frontend-test:${IMAGE_TAG} ${FRONTEND_ECR}:${IMAGE_TAG}
            aws ecr get-login-password \
              | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
            docker push ${FRONTEND_ECR}:${IMAGE_TAG}
          """
        }
      }
    }

    stage('Terraform Init & Plan') {
      steps {
        dir('infrastructure') {
          sh 'terraform init -input=false'
          sh """
            terraform plan \
              -input=false \
              -var="backend_image=${BACKEND_ECR}:${IMAGE_TAG}" \
              -var="frontend_image=${FRONTEND_ECR}:${IMAGE_TAG}" \
              -out=tfplan
          """
        }
      }
    }

    stage('Terraform Apply') {
      steps {
        dir('infrastructure') {
          sh 'terraform apply -input=false -auto-approve tfplan'
        }
      }
    }

    stage('Post-Deploy Info') {
      steps {
        dir('infrastructure') {
          script {
            def alb = sh(
              script: 'terraform output -raw alb_dns_name || terraform output -raw alb_dns',
              returnStdout: true
            ).trim()
            echo "✅ Deployment complete!"
            echo "👉 Frontend: http://${alb}"
            echo "👉 Backend API: http://${alb}/api"
          }
        }
      }
    }
  }

  post {
    success {
      echo "🎉 Build ${env.BUILD_NUMBER} succeeded!"
    }
    failure {
      echo "❌ Build ${env.BUILD_NUMBER} failed—check the logs above."
    }
  }
}
