pipeline {
  agent any

  environment {
    //Replace URLs
    GIT_REPO_URL       = "<GIT_REPO_URL>"
    AWS_REGION         = "<AWS_REGION>"
    ECR_ACCOUNT_ID     = "<AWS_ACCOUNT_ID>"
    FRONTEND_ECR_REPO  = "${ECR_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/frontend"
    BACKEND_ECR_REPO   = "${ECR_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/backend"
    ECS_CLUSTER        = "<ECS_CLUSTER_NAME>"
    FRONTEND_SERVICE   = "<FRONTEND_SERVICE_NAME>"
    BACKEND_SERVICE    = "<BACKEND_SERVICE_NAME>"
    // You can override this via Jenkins BUILD_NUMBER or leave as “latest”
    IMAGE_TAG          = "${env.BUILD_NUMBER ?: 'latest'}"
  }

  stages {
    stage('Install Prerequisites') {
      steps {
        sh '''
          set -e

          # 1) Docker
          if ! command -v docker &> /dev/null; then
            echo "Installing Docker..."
            amazon-linux-extras install docker -y
            systemctl enable docker
            systemctl start docker
            usermod -aG docker jenkins
          fi

          # 2) Git & unzip
          if ! command -v git &> /dev/null; then
            echo "Installing Git & unzip..."
            yum install -y git unzip
          fi

          # 3) AWS CLI v2
          if ! command -v aws &> /dev/null; then
            echo "Installing AWS CLI v2..."
            curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
            unzip -q awscliv2.zip
            ./aws/install
          fi

          # 4) Terraform
          if ! command -v terraform &> /dev/null; then
            echo "Installing Terraform..."
            TERRAFORM_VERSION="1.4.6"
            wget -q https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip
            unzip -q terraform_${TERRAFORM_VERSION}_linux_amd64.zip
            mv terraform /usr/local/bin/
          fi

          # 5) Node.js 16
          if ! command -v node &> /dev/null; then
            echo "Installing Node.js 16..."
            curl -sL https://rpm.nodesource.com/setup_16.x | bash -
            yum install -y nodejs
          fi

          # 6) Verify installs
          echo "Verifying installations..."
          docker --version
          git --version
          aws --version
          terraform -v
          node --version
          npm --version
        '''
      }
    }

    stage('Clone Repo') {
      steps {
        git branch: 'main', url: "${GIT_REPO_URL}"
      }
    }

    stage('Build Docker Images') {
      parallel {
        stage('Build Frontend') {
          steps {
            dir('frontend') {
              sh '''
                echo "Building frontend Docker image..."
                docker build -t $FRONTEND_ECR_REPO:$IMAGE_TAG .
              '''
            }
          }
        }
        stage('Build Backend') {
          steps {
            dir('backend') {
              sh '''
                echo "Building backend Docker image..."
                docker build -t $BACKEND_ECR_REPO:$IMAGE_TAG .
              '''
            }
          }
        }
      }
    }

    stage('Login to ECR') {
      steps {
        sh '''
          echo "Logging into ECR..."
          aws ecr get-login-password --region $AWS_REGION \
            | docker login --username AWS --password-stdin $FRONTEND_ECR_REPO
          aws ecr get-login-password --region $AWS_REGION \
            | docker login --username AWS --password-stdin $BACKEND_ECR_REPO
        '''
      }
    }

    stage('Push Images to ECR') {
      parallel {
        stage('Push Frontend') {
          steps {
            sh '''
              echo "Pushing frontend image..."
              docker push $FRONTEND_ECR_REPO:$IMAGE_TAG
            '''
          }
        }
        stage('Push Backend') {
          steps {
            sh '''
              echo "Pushing backend image..."
              docker push $BACKEND_ECR_REPO:$IMAGE_TAG
            '''
          }
        }
      }
    }

    stage('Deploy to ECS') {
      steps {
        sh '''
          echo "Deploying frontend service..."
          aws ecs update-service \
            --cluster $ECS_CLUSTER \
            --service $FRONTEND_SERVICE \
            --force-new-deployment \
            --region $AWS_REGION

          echo "Deploying backend service..."
          aws ecs update-service \
            --cluster $ECS_CLUSTER \
            --service $BACKEND_SERVICE \
            --force-new-deployment \
            --region $AWS_REGION
       
